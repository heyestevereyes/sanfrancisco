RESEND_API_KEY=
CONTACT_EMAIL_TO=

# Dominio real de producción, con protocolo y sin barra final
# (p. ej. https://sanfrancisco.com). Resuelve las URLs absolutas de
# Open Graph en src/app/layout.tsx. Sin esta variable el build avisa
# con "metadataBase property is not set".
NEXT_PUBLIC_SITE_URL=

# --- Sanity (CMS) ---
# Estas dos son públicas a propósito: las necesita el bundle del Studio
# embebido en /studio, además del servidor. No son secretos.
NEXT_PUBLIC_SANITY_PROJECT_ID=o9u4v7pb
NEXT_PUBLIC_SANITY_DATASET=production
# Opcional: fija la fecha de la API de Sanity. Si se omite, se usa la que
# está por defecto en src/sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=

# Secreto compartido con el webhook de Sanity (Manage → API → Webhooks).
# Lo verifica src/app/api/revalidate/route.ts antes de invalidar caché.
# Este SÍ es secreto — nunca ponerle un valor real a este archivo.
SANITY_REVALIDATE_SECRET=
